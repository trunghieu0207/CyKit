{
  "name": "cykit",
  "private": true,
  "version": "0.2.0",
  "description": "Fewer trips between kintone, Garoon and GitHub: a readable font, one-click PR copy, and a warning before merging a locked branch.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm typecheck && pnpm build:pages && pnpm build:content && pnpm build:background",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.config.content.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "package": "pnpm build && node scripts/package.mjs",
    "bump": "node scripts/bump.mjs",
    "watch": "concurrently -n pages,content -c cyan,magenta \"vite build --watch\" \"vite build --config vite.config.content.ts --watch\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "fonts": "node scripts/fetch-fonts.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "license": "MIT",
  "author": "Dang Trung Hieu"
}
