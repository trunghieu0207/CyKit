{
  "manifest_version": 3,
  "name": "CyKit Extension",
  "version": "0.1.2",
  "description": "Read and share work items faster: a cleaner, larger font on kintone and Garoon, plus one-click copy of GitHub PR titles and links.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CyKit Extension",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.cybozu.com/*",
        "https://*.kintone.com/*",
        "https://*.cybozu.cn/*",
        "https://*.kintone.cn/*",
        "https://*.cybozu-dev.com/*",
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://*.cybozu.com/*",
        "https://*.kintone.com/*",
        "https://*.cybozu.cn/*",
        "https://*.kintone.cn/*",
        "https://*.cybozu-dev.com/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://*.cybozu.com/*",
    "https://*.kintone.com/*",
    "https://*.cybozu.cn/*",
    "https://*.kintone.cn/*",
    "https://*.cybozu-dev.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
